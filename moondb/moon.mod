name = "Rz-coder8848/moon-typed-orm-moondb"

version = "0.1.0"

repository = "https://github.com/Rz-coder8848/moon-typed-orm"

license = "Apache-2.0"

keywords = [ "orm", "sql", "query-builder", "database", "moondb", "driver" ]

preferred_target = "wasm-gc"

description = "Moondb backend for moon-typed-orm: runs the compile-time-typed query DSL against any moondb driver, so one query codebase drives SQLite, Postgres, MySQL, or MockDriver."

import {
  "Rz-coder8848/moon-typed-orm@0.1.0",
  "moonbitstack/moondb@0.1.8",
}
